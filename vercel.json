{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/house-nameplates",
      "destination": "/category.html"
    },
    {
      "source": "/led-glow-signs",
      "destination": "/category.html"
    },
    {
      "source": "/3d-letter-signs",
      "destination": "/category.html"
    },
    {
      "source": "/acrylic-office-boards",
      "destination": "/category.html"
    },
    {
      "source": "/wall-branding",
      "destination": "/category.html"
    },
    {
      "source": "/design/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/collection",
      "destination": "/collection.html"
    },
    {
      "source": "/our-work",
      "destination": "/our-work.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/shipping-installation",
      "destination": "/shipping-installation.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=sitemap"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path((?!index$).*)",
      "destination": "/api/index?__path=:path"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
